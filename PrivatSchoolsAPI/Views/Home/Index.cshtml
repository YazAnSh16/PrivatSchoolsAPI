@{
    ViewData["Title"] = "الرئيسية";
    var isAuthenticated = User?.Identity?.IsAuthenticated == true;
}

<section class="auth-hero">
    <div class="text-center">
        <h1 class="auth-greeting">اهلا بكم</h1>
        <p class="auth-sub">في نظام إدارة معهد المصري</p>
    </div>

    @if (isAuthenticated)
    {
        <div class="auth-boxes">
            <a class="auth-box is-primary" asp-controller="Home" asp-action="Student">الذهاب إلى صفحة الطلاب</a>
            <a class="auth-box" href="/Identity/Account/Manage">إدارة الحساب</a>
        </div>
    }
    else
    {
        <div class="auth-boxes">
            <a class="auth-box is-primary" href="/Identity/Account/Login">تسجيل الدخول</a>
            <a class="auth-box" href="/Identity/Account/Register">إنشاء حساب جديد</a>
        </div>

        <div class="text-center">
            <a class="auth-link" href="/Identity/Account/ForgotPassword">نسيت كلمة المرور؟</a>
        </div>
    }
</section>
